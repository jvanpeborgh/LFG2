{
  "name": "lfg2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lfg/server & npm run dev -w @lfg/client",
    "build": "npm run build -w @lfg/client",
    "start": "npm run start -w @lfg/server",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client && tsc -p examples",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:rules": "node scripts/e2e-rules.mjs",
    "e2e:summons": "node scripts/e2e-summons.mjs",
    "view:summons": "node scripts/view-summons.mjs",
    "e2e:scenario": "node scripts/e2e-scenario.mjs",
    "e2e:voice": "node scripts/e2e-voice.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.55.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
