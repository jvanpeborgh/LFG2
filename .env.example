# Copy to .env (git-ignored) and fill in. The server reads it at startup; real environment variables win.

# Claude designs what players describe (/imagine) - an Anthropic API key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: another Claude model for the designer (default claude-opus-5-5), and how many turns it gets.
# DESIGNER_MODEL=claude-opus-5-5
# DESIGNER_MAX_TURNS=16

# Voice summons: a Whisper-compatible transcription endpoint (OpenAI, or a self-hosted whisper server).
# OPENAI_API_KEY=
# TRANSCRIBE_URL=http://localhost:9000/v1/audio/transcriptions
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
