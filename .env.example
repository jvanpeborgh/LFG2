# ---- Core ---------------------------------------------------------------
# Postgres. Optional in M0 (the player page degrades to placeholder state
# without it); required from M2 on.
DATABASE_URL=postgres://bidstream:bidstream@localhost:5432/bidstream
NODE_ENV=development

# Public base URL, used for QR codes, permalinks and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Stream -------------------------------------------------------------
# What the player loads. The broadcaster (M2) writes this playlist.
NEXT_PUBLIC_HLS_URL=/stream/live/index.m3u8
# Shown while the HLS playlist does not exist yet (M0) and whenever the
# player fails over. Must be a 16:9 mp4.
NEXT_PUBLIC_FALLBACK_MP4=/stream/placeholder.mp4

# Where the broadcaster writes HLS segments locally before/instead of R2.
STREAM_OUTPUT_DIR=./public/stream/live
HLS_SEGMENT_SECONDS=4

# ---- Generation (M1) ----------------------------------------------------
FAL_KEY=
# fal model ids. text-to-video and image-to-video variants.
FAL_T2V_MODEL=fal-ai/minimax/hailuo-02/standard/text-to-video
FAL_I2V_MODEL=fal-ai/minimax/hailuo-02/standard/image-to-video
# USD per generated second, used for the §9 economics assertion and the cap.
GEN_COST_USD_PER_SEC=0.08
MAX_DAILY_GEN_USD=200

# ---- Storage (M1) -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bidstream
# Public CDN origin for the bucket, no trailing slash.
R2_PUBLIC_BASE_URL=

# ---- Payments (M3) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
X402_WALLET=
X402_NETWORK=base

# ---- Moderation (M4) ----------------------------------------------------
MODERATION_LLM_KEY=
# Soft-block list on (nudity, gore, slurs, third-party IP). Default on.
SIMULCAST_SAFE=true

# ---- Shareability (M5) --------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ---- Simulcast (optional, off by default) -------------------------------
RTMP_TWITCH_URL=
