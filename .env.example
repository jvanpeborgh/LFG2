# Copy to .env (git-ignored) and fill in. The server reads it at startup; real environment variables win.

# Claude reads what players ask for (/summon, /event, /race, /hunt, /happen, /arc) and designs what
# they describe (/imagine) - an Anthropic API key from console.anthropic.com. Without it, requests are
# read by the built-in keyword rules.
ANTHROPIC_API_KEY=
# Optional: the reader (INTERPRETER=off keeps the keyword reading even with a key).
# INTERPRETER_MODEL=claude-opus-5-5
# INTERPRETER_EFFORT=low
# INTERPRETER_TIMEOUT_MS=25000
# INTERPRETER_DEBUG=1
# Optional: the fast draft and the background polish (empty polish = no second pass), and the draft's looks.
# DESIGNER_DRAFT_MODEL=claude-sonnet-5-5
# DESIGNER_POLISH_MODEL=claude-opus-5-5
# DESIGNER_RENDERS=2
# Limits: designs per player per day, per world per day, and popular prompts pre-designed per day.
# IMAGINE_DAILY=10
# IMAGINE_WORLD_DAILY=200
# IMAGINE_PREDESIGN_DAILY=5

# Voice summons: a Whisper-compatible transcription endpoint (OpenAI, or a self-hosted whisper server).
# OPENAI_API_KEY=
# TRANSCRIBE_URL=http://localhost:9000/v1/audio/transcriptions
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-1
